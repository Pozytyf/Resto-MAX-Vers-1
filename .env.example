# APP_URL: The public URL where this application is hosted (e.g. https://restomax.vercel.app).
APP_URL="http://localhost:3000"

# NODE_ENV & PORT: Server runtime configuration.
NODE_ENV="development"
PORT="3000"

# JWT_SECRET: Signing secret for session authentication tokens (MUST configure in production).
JWT_SECRET=""

# DATABASE_CLIENT: "sqlite" (default single-node WAL) or "pg" (Supabase PostgreSQL production).
DATABASE_CLIENT="sqlite"
DATABASE_PATH="./data/restomax.db"
# DATABASE_URL / SUPABASE_DB_URL: Supabase PostgreSQL connection string (Transaction Pooler port 6543 or Session port 5432).
DATABASE_URL=""
SUPABASE_DB_URL=""
DATABASE_SSL="true"
DB_POOL_MIN="0"
DB_POOL_MAX="10"

# SUPABASE: Project credentials (Server + Browser Realtime on Vercel).
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# MULTI-INSTANCE / PUBSUB: Unique server instance identifier & optional Redis channel.
INSTANCE_ID="restomax-node-1"
REDIS_URL=""

# PAYMENT_MODE & PAYDUNYA: TEST or LIVE (always keep TEST unless explicitly validated).
PAYMENT_MODE="TEST"
PAYDUNYA_MODE="TEST"
PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_TOKEN=""
PAYDUNYA_WEBHOOK_SECRET=""

# SMTP_* : Production SMTP server settings for automated critical stock email alerts.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Resto’MAX Alertes <alertes@restomax.ci>"

# WHATSAPP_CLOUD_API: Global fallback credentials for Meta WhatsApp Cloud API.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
